# Copy to .env in this directory (optional; defaults work for local dev)
#
# vision-ops-app (Next.js) → http://localhost:3000
# This API (FastAPI)       → http://localhost:8000

CAMERA_INDEX=0
API_HOST=0.0.0.0
API_PORT=8000
# Must include every origin you use to open the UI (port 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# If you open the UI via Network (e.g. http://192.168.0.113:3000), also add:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.113:3000
# PUBLIC_API_BASE=http://192.168.0.113:8000
MJPEG_FPS=12
PUBLIC_API_BASE=http://localhost:8000

# Face recognition (SFace + YuNet in models/)
FACE_ENABLED=true
OWNER_NAME=You
FACE_MATCH_THRESHOLD=0.5
FACE_DETECT_EVERY_N_FRAMES=3
