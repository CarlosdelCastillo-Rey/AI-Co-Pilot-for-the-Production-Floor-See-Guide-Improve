# Copy to .env in this directory (optional; defaults work for local dev)
#
# vision-ops-app (Next.js) → http://localhost:3000
# This API (FastAPI)       → http://localhost:8000

# MacBook / USB webcam for /live and Identity (off by default — HAR uses mock-videos only)
WEBCAM_ENABLED=false
CAMERA_INDEX=0
API_HOST=0.0.0.0
API_PORT=8000
# Must include every origin you use to open the UI (port 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# If you open the UI via Network (e.g. http://192.168.0.113:3000), also add:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.113:3000
# PUBLIC_API_BASE=http://192.168.0.113:8000
MJPEG_FPS=12
PUBLIC_API_BASE=http://localhost:8000

# Face recognition (SFace + YuNet in models/)
FACE_ENABLED=false
OWNER_NAME=You
FACE_MATCH_THRESHOLD=0.5
FACE_DETECT_EVERY_N_FRAMES=3

# Industrial mock cameras (cam-har-01…05 on mock-videos) on GET /api/cameras when VISION_ENABLED=true
VISION_ENABLED=true

# HAR activity models (Avance 4) — cam-har-01…05 on GET /api/cameras
HAR_ENABLED=true
HAR_CHECKPOINT_DIR=notebooks/Avance 4. Modelos alternativos/Checkpoints
# HAR_SHARED_CLIP_PATH=/absolute/path/to/demo.mp4
# HF_TOKEN=hf_xxx
HAR_PERSIST_ENABLED=true
HAR_ACTIVITY_INGEST_ENABLED=true
ALERTING_API_URL=http://localhost:8001
# HAR_AUTO_PROBE_ON_START=true
# HAR_LIVE_ENABLED=true
# HAR_LIVE_INFER_EVERY=16
# HAR_LIVE_SHOW_HEATMAP=true
# HAR_LIVE_SHOW_YOLO_BOXES=true
