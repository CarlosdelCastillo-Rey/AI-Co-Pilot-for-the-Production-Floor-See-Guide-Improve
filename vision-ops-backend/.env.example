# Copy to .env in this directory (vision-ops-backend/)
#
# Unified VisionOps API — vision inference + ops (SQLite, alerts, HITL, advisor)
# Frontend (Next.js) → http://localhost:3000  |  This API → http://localhost:8000

# --- Vision layer (unprefixed) ---
WEBCAM_ENABLED=false
CAMERA_INDEX=0
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_BASE=http://localhost:8000
MJPEG_FPS=12

FACE_ENABLED=false
OWNER_NAME=You
FACE_MATCH_THRESHOLD=0.5

VISION_ENABLED=true
HAR_ENABLED=true
HAR_CHECKPOINT_DIR=har-research/checkpoints
HAR_PERSIST_ENABLED=true
HAR_ACTIVITY_INGEST_ENABLED=true
HAR_LIVE_ENABLED=true
HAR_V2_SESSION_ENABLED=true
HAR_LIVE_PER_PERSON_MODE=true

# --- Ops layer (VISIONOPS_ prefix) ---
VISIONOPS_DRY_RUN=true
VISIONOPS_CORS_ORIGINS=http://localhost:3000

# VISIONOPS_MAILERSEND_API_TOKEN=
# VISIONOPS_FROM_EMAIL=
# VISIONOPS_TO_EMAIL=
# VISIONOPS_TELEGRAM_BOT_TOKEN=
# VISIONOPS_TELEGRAM_CHAT_IDS=

VISIONOPS_OLLAMA_HOST=http://127.0.0.1:11434
VISIONOPS_OLLAMA_MODEL=llama3.1

# VISIONOPS_AUTH_SECRET=change-me-in-production
# VISIONOPS_DATABASE_URL=sqlite:////absolute/path/to/vision-ops-backend/data/vision_ops.db
# VISIONOPS_HAR_SESSION_ARTIFACTS_DIR=vision-ops-backend/data/har_sessions
# VISIONOPS_SEED_DB=false   # no synthetic timeline seed; live HAR fills data
