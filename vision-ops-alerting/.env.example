# Never commit real tokens/secrets.
ALERTING_MAILERSEND_API_TOKEN=""

ALERTING_FROM_EMAIL="info@test-vz9dlemy8zp4kj50.mlsender.net"
ALERTING_FROM_NAME="VisionOps"

# Comma-separated recipient list
ALERTING_TO_EMAIL="carlospano8@gmail.com"
ALERTING_TO_NAME="Recipient"

# If true, do not send—just classify + render template
ALERTING_DRY_RUN="false"

# Local model for Strands classification (requires Ollama running)
ALERTING_OLLAMA_MODEL="llama3.1"
# Advisor chat temperature (0–1; higher = more varied phrasing)
ALERTING_ADVISOR_TEMPERATURE=0.75

# CORS for UI
ALERTING_CORS_ORIGINS="http://localhost:3000"

# Auth (change secret in production)
# ALERTING_AUTH_SECRET="your-random-secret"
# ALERTING_AUTH_TOKEN_HOURS=72
# Default admin seeded on first start when no users exist:
# ALERTING_SEED_ADMIN_EMAIL=admin@visionops.local
# ALERTING_SEED_ADMIN_PASSWORD=admin123
# ALERTING_SEED_ADMIN_NAME="Plant Supervisor"

# SQLite database (absolute path recommended for DBeaver)
# Default file: vision-ops-alerting/data/vision_ops.db
# ALERTING_DATABASE_URL="sqlite:////full/path/to/vision-ops-alerting/data/vision_ops.db"

# Demo seed data on empty DB (off by default — empty tables stay empty)
# ALERTING_SEED_DB="true"

# HAR integral activity logs
# ALERTING_HAR_LOG_RETENTION_DAYS=7
# ALERTING_HAR_PROMOTE_NON_ASSEMBLY=true
# ALERTING_HAR_LOW_CONFIDENCE_THRESHOLD=0.15
# ALERTING_HAR_EMAIL_ENABLED=false
# ALERTING_HAR_PRIMARY_ACTION_LABEL="Assemble system"
